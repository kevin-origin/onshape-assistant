{
  "manifest_version": 3,
  "name": "Onshape Assistant",
  "version": "2.1.35",
  "update_url": "https://raw.githubusercontent.com/kevin-origin/onshape-assistant/main/updates.xml",
  "description": "Onshape assistant \u2014 drawing creator, doc scanner, violations & interference checker",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting",
    "cookies",
    "notifications",
    "webNavigation",
    "debugger",
    "downloads",
    "alarms"
  ],
  "host_permissions": [
    "https://cad.onshape.com/*",
    "https://*.onshape.com/*",
    "http://localhost/*",
    "https://*.onrender.com/*",
    "https://*.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cad.onshape.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://cad.onshape.com/*"
      ],
      "js": [
        "content-main.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Onshape Assistant"
  }
}

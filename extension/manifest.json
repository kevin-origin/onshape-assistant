{
  "manifest_version": 3,
  "name": "Onshape Tab Folder Scanner",
  "version": "1.0",
  "description": "Reads tab folder structure from Onshape documents for compliance monitoring",
  "permissions": ["activeTab", "storage", "tabs", "scripting"],
  "host_permissions": [
    "https://cad.onshape.com/*",
    "http://localhost/*",
    "https://*.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["https://cad.onshape.com/documents/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scan Tab Folders"
  }
}
